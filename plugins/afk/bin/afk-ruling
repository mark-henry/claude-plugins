#!/usr/bin/env bash
# Record one of the user's rulings: append a dated line with their words, verbatim, to rulings.md.
#
# usage: afk-ruling <rulings.md> "<topic>" "<the user's words, as typed>" [--proposal "<what you proposed>"]
#   <rulings.md>  the run folder's rulings file; started, with its folder, if missing.
#   <topic>       what the sentence caps, grants or decides (cap, push, bar, scope ...).
#   <words>       exactly what the user typed. Newlines become spaces; nothing else is changed.
#   --proposal    your proposal the words answer, so "approved" can be read cold.
#
# It only ever appends, so earlier rulings keep their words and their dates. Prints the line it wrote.
# Exit 2 on usage; exit 1, writing nothing, when the words are empty or the file cannot be written.
set -uo pipefail
usage() { echo 'usage: afk-ruling <rulings.md> "<topic>" "<the user'"'"'s words>" [--proposal "<your proposal>"]' >&2; exit 2; }
[ $# -ge 3 ] || usage
file=$1 topic=$2 words=$3; shift 3
proposal=
while [ $# -gt 0 ]; do
  case "$1" in
    --proposal) [ $# -ge 2 ] || usage; proposal=$2; shift 2 ;;
    *) echo "afk-ruling: unknown argument: $1" >&2; exit 2 ;;
  esac
done
one_line() { printf '%s' "$1" | tr '\n' ' ' | sed -e 's/[[:space:]]*$//'; }
words=$(one_line "$words"); topic=$(one_line "$topic"); proposal=$(one_line "$proposal")
[ -n "$words" ] || { echo "afk-ruling: refused: no words given. Record what the user typed, verbatim." >&2; exit 1; }

stamp=$(date '+%Y-%m-%d %H:%M')
if [ -n "$proposal" ]; then line="- $stamp, $topic. My proposal: $proposal: user \"$words\""
else line="- $stamp, $topic: user \"$words\""; fi

{ mkdir -p "$(dirname "$file")" && { [ -e "$file" ] || printf '# Rulings\n\n' > "$file"; } && printf '%s\n' "$line" >> "$file"; } 2>/dev/null \
  || { echo "afk-ruling: could not write $file" >&2; exit 1; }
printf '%s\n' "$line"
