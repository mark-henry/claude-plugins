#!/usr/bin/env python3
"""Build a Google Flights one-way search URL (tfs) for IATA airports.
Layout inferred by decoding a UI-generated tfs (Mexico City->Cancun, one way, nonstop,
departure 8AM-8PM, 1 adult) and then confirmed by rendering variants in Chrome.
Usage: flights-tfs ORIGIN DEST YYYY-MM-DD [--stops 0|1|2|any] [--dep 8-19|none] [--adults 1]
"""
import argparse, base64
def varint(n):
    o=b''
    while True:
        b=n&0x7f; n>>=7
        o+=bytes([b|(0x80 if n else 0)])
        if not n: return o
def f(num,wire,val): return varint(num<<3|wire)+val
def ld(num,b): return f(num,2,varint(len(b))+b)
def vi(num,n): return f(num,0,varint(n))
def place(code):  # type 1 = airport (IATA), 3 = city (Knowledge Graph /m/ id)
    return (b'\x08\x03' if code.startswith('/m/') else b'\x08\x01')+b'\x12'+bytes([len(code)])+code.encode()
def build(o,d,date,stops=0,dep=(8,19),adults=1):
    leg=ld(2,date.encode())
    if stops!='any': leg+=vi(5,int(stops))
    if dep: leg+=vi(8,dep[0])+vi(9,dep[1])+vi(10,0)+vi(11,23)
    leg+=ld(13,place(o))+ld(14,place(d))
    msg=vi(1,28)+vi(2,2)+ld(3,leg)
    msg+=b''.join(vi(8,1) for _ in range(adults))+vi(9,1)+vi(14,1)
    msg+=ld(16,b'\x08'+b'\xff'*9+b'\x01')+vi(19,2)
    return base64.urlsafe_b64encode(msg).decode().rstrip('=')
if __name__=='__main__':
    a=argparse.ArgumentParser();a.add_argument('o');a.add_argument('d');a.add_argument('date')
    a.add_argument('--stops',default='0');a.add_argument('--dep',default='8-19');a.add_argument('--adults',type=int,default=1)
    x=a.parse_args()
    dep=None if x.dep=='none' else tuple(map(int,x.dep.split('-')))
    print('https://www.google.com/travel/flights/search?tfs='+build(x.o,x.d,x.date,x.stops if x.stops=='any' else int(x.stops),dep,x.adults)+'&tfu=EgYIABAAGAA&curr=USD&hl=en')
