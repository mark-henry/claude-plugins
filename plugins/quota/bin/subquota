#!/bin/bash
# subquota: report weekly quota left on each subscription behind CLIProxyAPI against a linear-use
# target, and with --rebalance, set the Claude credentials' routing weights to match.
#
# Numbers are the rate-limit headers CLIProxyAPI last saw per credential (management API
# /v0/management/auth-files), as of that credential's last proxied request (`seen`), not live.
#   left    = 100 - used%
#   reserve = the last % a Claude account keeps for people using it outside the proxy (QUOTA_RESERVES);
#             a last resort, not a wall. 0 for accounts not listed, and for every non-Claude account.
#   target  = what `left` would be if spent evenly down to the reserve by the reset:
#             reserve + (100 - reserve) * share of the window still to come
#   slack   = left - target; positive is slack, negative is spending over pace (or inside the reserve).
#             The report shows it as "N pts over pace" / "N pts under pace" / "on pace"
#
# Rebalance policy (Claude accounts; weights are relative, session-affine in the proxy): winner takes all.
#   If any account has slack, the winner is the one with the most slack per hour to reset (urgency:
#   slack about to be lost at a reset goes first). If every account is over pace, the winner is
#   the one least far over (plain slack, since a near reset will fix the overspend by itself).
#   The winner gets 100; every other account with quota left gets FLOOR (in the pool, ~no new sessions).
#   Spending the winner shrinks its slack until another account overtakes it, so the split evens out.
#   An account inside its reserve has negative slack, so it loses to any account that is not; when all
#   are inside, the one least far in wins and the reserves drain evenly.
#   An account with no reading (after a proxy restart) gets FLOOR_UNREAD, so it serves a request soon and can be read.
#   Only an account with nothing left gets 0, because weight 0 takes it out of the pool the proxy fails
#   over to: e.g. a session whose account has hit the Fable cap (7d_oi) could not move anywhere else.
#
# Fable reserve (QUOTA_FABLE_RESERVES): an account's last N% of its weekly Fable cap (7d_oi) is a last
#   resort too. While its Fable left is at or under that and another Claude account can still serve
#   Fable (not Fable-blocked, not held, Fable left above 1% and above its own Fable reserve, some general
#   quota left), --rebalance adds FABLE_PATTERN to the credential's excluded_models, so the proxy routes
#   no Fable there and fails Fable sessions over to the others. The exclusion is lifted when no other
#   account can serve Fable (the last resort) or when the account's Fable window resets. Its other excluded
#   models are left alone. The 1% margin lifts it a little before the others hit the cap, because the
#   rebalance runs only every 15 minutes. With no Fable reading yet (after a proxy restart) nothing is
#   excluded until one arrives. Excluding Fable drops the credential's Fable reading, and the hold stops
#   it serving the Fable requests that would renew it, so --rebalance saves the Fable reset time in
#   $QUOTA_STATE_DIR/fable-holds.json and keeps a held credential held, with no reading, until then.
#   The auth-files listing does not show excluded_models; each credential's auth file is read for it.
#
# Pace note, printed under the report only when it applies: any account at or over pace (slack
# rounds to 0 or below), with a request that the agent say so in its first reply of the session.
#
# Session affinity: claude-mitm's addon records the auth_index CLIProxyAPI picked for each Claude Code
# session (from the X-CPA-TRACE-ID response header) in $QUOTA_SESSION_AUTH_DIR/<session id>; the
# account matching $CLAUDE_CODE_SESSION_ID is marked "← this session". Absent before the first request.
#
# --quiet: print nothing and exit 0 if the proxy is unreachable (for hooks)
# --rebalance: also PATCH changed weights via the management API; changes are appended to $LOG
# --dry-run: show the weights --rebalance would set, without setting them
# --install-launchd: (macOS) run --rebalance every 15 minutes in the background
#
# Settings: override the defaults below in the environment or in ~/.config/quota.env (sourced as bash).
set -euo pipefail

: "${QUOTA_PROXY_URL:=http://127.0.0.1:8317}"            # CLIProxyAPI base URL
: "${QUOTA_MANAGEMENT_KEY_FILE:=~/.cli-proxy-api/management-key}"
: "${QUOTA_RESERVES:=}"                                  # "email=pct,email=pct": last % of each Claude account's weekly quota kept back; a last resort
: "${QUOTA_FABLE_RESERVES:=}"                            # same, for the weekly Fable cap
: "${QUOTA_FABLE_PATTERN:=claude-fable-*}"               # excluded_models entry that holds Fable back
# Older single-account settings, still honored when the lists above are empty:
: "${QUOTA_PROTECTED_EMAIL:=}" "${QUOTA_RESERVE:=10}" "${QUOTA_FABLE_RESERVE:=10}"
: "${QUOTA_STATE_DIR:=~/.cache/quota}"                   # remembers when a held Fable reserve resets
: "${QUOTA_FLOOR:=1}"                                    # minimum weight for an account with headroom: in the pool, ~no new sessions
: "${QUOTA_FLOOR_UNREAD:=10}"                            # weight for an account with no reading, so it serves a request soon and can be read
: "${QUOTA_LOG:=~/Library/Logs/quota-rebalance.log}"
: "${QUOTA_SESSION_AUTH_DIR:=~/.cache/claude-mitm/session-auth}"  # written by claude-mitm's addon
[[ -f ~/.config/quota.env ]] && source ~/.config/quota.env
API=$QUOTA_PROXY_URL/v0/management
FABLE_PATTERN=$QUOTA_FABLE_PATTERN FLOOR=$QUOTA_FLOOR FLOOR_UNREAD=$QUOTA_FLOOR_UNREAD
if [[ -n $QUOTA_PROTECTED_EMAIL ]]; then
  : "${QUOTA_RESERVES:=$QUOTA_PROTECTED_EMAIL=$QUOTA_RESERVE}" "${QUOTA_FABLE_RESERVES:=$QUOTA_PROTECTED_EMAIL=$QUOTA_FABLE_RESERVE}"
fi
pct_map() { # "email=pct,email=pct" -> {"email": pct}
  jq -nc --arg s "$1" '[$s | split(",")[] | gsub("^\\s+|\\s+$"; "") | select(length > 0) | split("=")
    | {(.[0] | gsub("\\s"; "")): (.[1] | gsub("\\s"; "") | tonumber)}] | add // {}'
}
if ! RESERVES=$(pct_map "$QUOTA_RESERVES") || ! FABLE_RESERVES=$(pct_map "$QUOTA_FABLE_RESERVES"); then
  echo "subquota: QUOTA_RESERVES and QUOTA_FABLE_RESERVES take \"email=pct,email=pct\"" >&2; exit 2
fi
SESSION_AUTH_DIR=${QUOTA_SESSION_AUTH_DIR/#\~/$HOME} STATE_DIR=${QUOTA_STATE_DIR/#\~/$HOME}
LOG=${QUOTA_LOG/#\~/$HOME} KEY_FILE=${QUOTA_MANAGEMENT_KEY_FILE/#\~/$HOME}
export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH

quiet=0 rebalance=0 dry=0
for a in "$@"; do
  case $a in
    --quiet) quiet=1 ;;
    --rebalance) rebalance=1 ;;
    --dry-run) rebalance=1 dry=1 ;;
    --install-launchd)
      label=io.github.mark-henry.quota-rebalance
      plist=~/Library/LaunchAgents/$label.plist
      self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
      mkdir -p "$(dirname "$LOG")"
      cat >"$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array><string>$self</string><string>--rebalance</string><string>--quiet</string></array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PLIST
      launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
      launchctl bootstrap "gui/$(id -u)" "$plist"
      echo "installed $plist (runs $self --rebalance every 15 min; log $LOG)"
      exit 0 ;;
    *) echo "usage: subquota [--quiet] [--rebalance | --dry-run | --install-launchd]" >&2; exit 2 ;;
  esac
done

if [[ ! -r $KEY_FILE ]]; then
  ((quiet)) && exit 0
  echo "subquota: no CLIProxyAPI management key at $QUOTA_MANAGEMENT_KEY_FILE (set QUOTA_MANAGEMENT_KEY_FILE in ~/.config/quota.env)" >&2
  exit 1
fi
key=$(<"$KEY_FILE")
if ! json=$(curl -sf -m 20 -H "Authorization: Bearer $key" "$API/auth-files"); then
  ((quiet)) && exit 0
  echo "subquota: can't reach CLIProxyAPI management API" >&2
  exit 1
fi

session_auth=
if [[ -d $SESSION_AUTH_DIR ]]; then
  find "$SESSION_AUTH_DIR" -type f -mtime +7 -delete 2>/dev/null || true
  [[ -n ${CLAUDE_CODE_SESSION_ID:-} && -r $SESSION_AUTH_DIR/$CLAUDE_CODE_SESSION_ID ]] &&
    session_auth=$(<"$SESSION_AUTH_DIR/$CLAUDE_CODE_SESSION_ID")
fi

# The listing does not show excluded_models, so read each Claude credential's own auth file for it.
# {"<name>": [excluded models]}; a credential whose file can't be read falls back to the listing.
excl_files=$(jq -r '.files[] | select(.provider == "claude" and .path != null) | [.name, .path] | @tsv' <<<"$json" |
  while IFS=$'\t' read -r n p; do
    [[ -r $p ]] && jq -c --arg n "$n" '{($n): (.excluded_models // [] | if type == "array" then . else [] end)}' "$p" 2>/dev/null
  done | jq -sc 'add // {}')
# Excluding Fable drops the credential's Fable reading, and it serves no Fable to renew it, so the
# Fable reset time seen when the hold was set is kept here: {"<name>": reset epoch}.
holds_file=$STATE_DIR/fable-holds.json
holds=$(jq -c 'if type == "object" then . else {} end' "$holds_file" 2>/dev/null || echo '{}')

# Emits tab-separated rows: "L<TAB>report line", "P<TAB>account at or over pace" and
# "W<TAB>name<TAB>email<TAB>old<TAB>new<TAB>why"
rows=$(jq -r --argjson now "$(date +%s)" --arg mine "$session_auth" \
  --argjson reserves "$RESERVES" --argjson freserves "$FABLE_RESERVES" --arg fpat "$FABLE_PATTERN" \
  --argjson exclf "$excl_files" --argjson holds "$holds" \
  --argjson floor "$FLOOR" --argjson floor_unread "$FLOOR_UNREAD" '
  def week: 604800;
  def epoch: (.[0:19] + "Z" | fromdateiso8601) -
    ((.[19:] | capture("(?<s>[+-])(?<h>\\d\\d):(?<m>\\d\\d)$")) as $z
     | ($z.h | tonumber) * 3600 + ($z.m | tonumber) * 60 | if $z.s == "-" then -. else . end)? // 0;
  def ago: (($now - .) / 60 | floor) as $m
    | if $m < 120 then "\($m)m" elif $m < 2880 then "\($m / 60 | floor)h" else "\($m / 1440 | floor)d" end;
  def num: if . == null or . == "" then null else tonumber end;
  def pct: round | tostring + "%";
  def until(t): ((t - $now) / 3600) as $h
    | if $h >= 48 then "\($h / 24 * 10 | round / 10)d" else "\($h | round)h" end;
  def resets: "resets " + until(.reset);
  def who: .email | split("@")[0];
  def oi(k): .fsig["Anthropic-Ratelimit-Unified-7d_oi-" + k];

  # One record per enabled credential, from its newest observation.
  [ .files[] | select(.disabled | not)
    | ([.quota // {}] + [(.model_quotas // {})[]] | map(select((.signals // {}) | length > 0)) | max_by(.observed_at | epoch)) as $o
    # The Fable cap: Fable responses carry an extra weekly window, 7d_oi, the one that rejects Fable.
    | ((.model_quotas // {}) | to_entries
       | map(select(.key | startswith("claude-fable")) | .value
             | select((.signals // {})["Anthropic-Ratelimit-Unified-7d_oi-Utilization"] != null))
       | max_by(.observed_at | epoch) | .signals) as $fs
    | {name, provider, auth_index, email: (.email // "?"), weight, sig: $o.signals, fsig: $fs,
       excluded: ($exclf[.name] // .excluded_models // [] | if type == "array" then . else [] end),
       seen: ($o.observed_at // null | if . then epoch else null end)}
    | if .sig == null then .
      elif .provider == "claude" then
        .used = (.sig["Anthropic-Ratelimit-Unified-7d-Utilization"] | num | if . then . * 100 else null end)
        | .reset = (.sig["Anthropic-Ratelimit-Unified-7d-Reset"] | num) | .length = week
      elif .provider == "codex" then
        .used = (.sig["X-Codex-Primary-Used-Percent"] | num)
        | .reset = (.sig["X-Codex-Primary-Reset-At"] | num)
        | .mins = (.sig["X-Codex-Primary-Window-Minutes"] | num // 0)
        | .length = (if .mins > 0 then .mins * 60 else null end)
        | .plan = (.sig["X-Codex-Plan-Type"] // "?")
      else . end
    # Reserves are per Claude account; a Codex credential can share an email with one.
    | .res = (if .provider == "claude" then $reserves[.email] // 0 else 0 end)
    | .fres = (if .provider == "claude" then $freserves[.email] // 0 else 0 end)
    | .passed = (.reset != null and .reset <= $now)
    | .left = (if .used == null then null elif .passed then 100 else 100 - .used end)
    | .target = (if .passed or .reset == null or .length == null then null
                 else .res + (100 - .res) * (.reset - $now) / .length end)
    | .freset = (oi("Reset") | num)
    | .fpassed = (.freset != null and .freset <= $now)
    | .fleft = (if .fpassed then 100 else oi("Utilization") | num | if . == null then null else 100 - . * 100 end end)
    | .fblocked = (.fleft != null and (.fpassed | not) and (.fleft <= 0 or oi("Status") == "rejected"))
    # Can take a session whose account is Fable-blocked: Fable not blocked (no reading counts as open),
    # and general quota above what the account keeps back (its reserve).
    | .fok = (.provider == "claude" and (.fblocked | not) and (.left == null or .left > .res))
    | .held = (.excluded | index($fpat) != null)
  ] as $creds0
  # Fable reserve: hold back the last .fres% of each Fable cap while another account can serve
  # Fable. An account that is held, or inside its own Fable reserve, does not count, so two reserves
  # never hold each other.
  | ($creds0 | map(select(.provider == "claude" and (.fblocked | not) and (.held | not)
                          and (.fleft == null or .fleft > ([1, .fres] | max)) and (.left == null or .left > 0))
                   | .name)) as $fable_servers
  | ($creds0 | map(
      .name as $n
      # Held with no fresh reading (the exclusion hid it): keep holding until the saved Fable reset.
      | .fsaved = ($holds[.name] // null)
      | .fguard = (.provider == "claude" and .fres > 0 and ($fable_servers - [$n] | length > 0)
                   and (if .fleft != null then (.fpassed | not) and .fleft <= .fres
                        else .held and .fsaved != null and .fsaved > $now end))
      | .fhold_until = (if .fguard then (if .fleft != null then .freset else .fsaved end) else null end)
      | .fexcl = ((.excluded - [$fpat]) + (if .fguard then [$fpat] else [] end))
    )) as $creds
  | ($creds | map(select(.fblocked))) as $fblocked
  | ($creds | map(select(.fok))) as $fok

  # Report lines
  | ($creds[] | "L\t- \(.provider) \(.email | split("@")[0])" + (if .plan then " \(.plan)" else "" end)
      + (if .weight != null then " (weight \(.weight))" else "" end) + ": "
      + (if .sig == null then "no data yet"
         elif .used == null then "format not understood"
         else (if .provider == "codex" and .mins != 10080 then (if .mins > 0 then "\(.mins / 60 | round)h window " else "? window " end) else "" end)
           + (if .res > 0 then "keeps \(.res)%, " else "" end)
           + (if .passed then "reset since seen (~100%)"
              else (.left | pct)
                + " left"
                + (if .target then (.left - .target | round) as $p
                   | ", " + (if $p < 0 then "\(-$p) pts over pace" elif $p > 0 then "\($p) pts under pace" else "on pace" end)
                     + " (pace \(.target | pct))" else "" end)
                + (if .reset then ", \(resets)" else "" end)
              end)
           + ", seen \(.seen | ago)"
         end)
      + (if .fblocked then "; Fable blocked, back in \(until(.freset))"
         elif .fleft != null then "; Fable \(.fleft | pct) left" else "" end)
      + (if .excluded | index($fpat) then " (Fable reserve held: last resort only)" else "" end)
      + (if $mine != "" and .auth_index == $mine then "  ← this session" else "" end)),

  # Accounts at or over pace
  ($creds[] | select(.left != null and .target != null) | (.left - .target | round) as $p | select($p <= 0)
   | "P\t\(.provider) \(who) (\(if $p < 0 then "\(-$p) over" else "on pace" end))"),

  # Fable note: which accounts have hit the Fable cap, and where their sessions fail over to
  (if ($fblocked | length) == 0 then empty
   elif ($fok | length) == 0 then "F\tFable blocked on every account."
   else "F\tFable blocked on \($fblocked | map(who) | join(", ")); its sessions fall back to \($fok | map(who) | join(" or ")) on their next Fable request."
   end),

  # Rebalance proposals for every Claude credential: winner takes all (see the policy at the top)
  ([ $creds[] | select(.provider == "claude")
     | if .left == null or .reset == null then .nodata = true
       else
         .next = (if .passed then .reset + week * ((($now - .reset) / week | floor) + 1) else .reset end)
         | .hrs = ([(.next - $now) / 3600, 1] | max)
         | .slack = .left - (.res + (100 - .res) * (.next - $now) / week)
         | .live = (.left > 0)
       end ] as $c
   | ($c | map(select(.live == true))) as $live
   | ($live | any(.slack > 0)) as $urgency
   | ($live | map(.score = (if $urgency then .slack / .hrs else .slack end)) | max_by(.score) | .name // null) as $win
   | $c[]
   | .new = (if .nodata then $floor_unread elif .live | not then 0 elif .name == $win then 100 else $floor end)
   | .why = (if .nodata then "no reading" elif .live | not then "nothing left"
             else "slack \(if .slack >= 0 then "+" else "" end)\(.slack | round), \(.hrs | round)h to reset"
               + (if .name != $win then "" elif $urgency then ", most urgent" else ", least over pace" end) end)
   | "W\t\(.name)\t\(.email)\t\(.weight // 1)\t\(.new)\t\(.why)"
  ),

  # Fable reserve changes: "X<TAB>name<TAB>email<TAB>new excluded_models JSON<TAB>held|released"
  ($creds[] | select(.provider == "claude" and (.fexcl | sort) != (.excluded | sort))
   | "X\t\(.name)\t\(.email)\t\(.fexcl | tojson)\t\(if .fguard then "held" else "released" end)"),

  # Fable reserve state to keep: "H<TAB>{name: reset}" for every held credential
  "H\t\([$creds[] | select(.fguard and .fhold_until != null) | {(.name): .fhold_until}] | add // {} | tojson)"
' <<<"$json")

echo "Quota (weekly % left; pace = what spending evenly to the reset would leave; over pace = spending too fast):"
grep '^L' <<<"$rows" | cut -f2- || true
over=$(grep '^P' <<<"$rows" | cut -f2- || true)
fable=$(grep '^F' <<<"$rows" | cut -f2- || true)
[[ -n $over ]] && echo "At or over pace: $(paste -sd ';' - <<<"$over" | sed 's/;/, /g')."
[[ -n $fable ]] && echo "$fable"
if [[ -n $over || -n $fable ]]; then
  echo "(Tell the user this in one line in your first reply of the session; don't repeat it after that.)"
fi

((rebalance)) || exit 0
changes=()
while IFS=$'\t' read -r _ name email old new why; do
  [[ $old == "$new" ]] && continue
  if ((dry)); then changes+=("${email%@*} ${old}→${new} ($why)"); continue; fi
  if curl -sf -m 20 -X PATCH -H "Authorization: Bearer $key" -H 'Content-Type: application/json' \
       -d "$(jq -nc --arg n "$name" --argjson w "$new" '{name: $n, weight: $w}')" "$API/auth-files/fields" >/dev/null; then
    changes+=("${email%@*} ${old}→${new} ($why)")
  else
    changes+=("${email%@*} ${old}→${new} FAILED")
  fi
done < <(grep '^W' <<<"$rows" || true)

while IFS=$'\t' read -r _ name email excl what; do
  label="${email%@*} Fable reserve $what"
  if ((dry)); then changes+=("$label"); continue; fi
  if curl -sf -m 20 -X PATCH -H "Authorization: Bearer $key" -H 'Content-Type: application/json' \
       -d "$(jq -nc --arg n "$name" --argjson x "$excl" '{name: $n, excluded_models: $x}')" "$API/auth-files/fields" >/dev/null; then
    changes+=("$label")
  else
    changes+=("$label FAILED")
  fi
done < <(grep '^X' <<<"$rows" || true)

if ! ((dry)); then
  new_holds=$(grep '^H' <<<"$rows" | cut -f2- || true)
  if [[ -n $new_holds && $new_holds != "$holds" ]]; then
    mkdir -p "$STATE_DIR" && printf '%s\n' "$new_holds" >"$holds_file.tmp" && mv "$holds_file.tmp" "$holds_file"
  fi
fi

if ((${#changes[@]})); then
  msg="$( ((dry)) && echo "would rebalance" || echo rebalanced): $(IFS=';'; echo "${changes[*]}" | sed 's/;/; /g')"
  echo "$msg"
  ((dry)) || echo "$(date '+%Y-%m-%d %H:%M:%S') $msg" >>"$LOG"
else
  echo "rebalance: weights already match"
fi
