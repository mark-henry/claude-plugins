{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/subquota\" --quiet 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
