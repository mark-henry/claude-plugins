#!/usr/bin/env bash
# Supervisor for a check-gated agent loop (see the unattended:arbiter skill).
# Each pass: a fresh worker reads the prompt, then the supervisor (not the worker) runs the check.
# The stop decision comes only from what the check writes to $ARBITER_RESULT; the worker's exit code,
# messages and ledger are never read.
#
# This is not isolation. Every command runs as the user who launched the script, so a worker can still
# reach whatever that user can: the check, the state directory, this process. The script keeps its own
# files out of the worker's directory and environment and refuses layouts that put them inside; real
# separation needs the worker to run as another user or in a container.
#
# usage: AGENT_CMD='...' CHECK_CMD='...' arbiter-loop <loop-dir> [max-passes]
#   <loop-dir>  the worker's working directory (usually its worktree root); AGENT_CMD runs there.
#   max-passes  total passes for this STATE_DIR, counted across launches (default 20). A relaunch continues
#               the count and the pass numbering; to run more, raise the number. A count below the pass
#               logs on disk is refused as tampering.
#   AGENT_CMD   required. Reads the prompt on stdin; none of the variables below reach it. Put a timeout
#               and a budget in it.
#   CHECK_CMD   required. Runs in CHECK_DIR with LOOP_DIR=<loop-dir> and ARBITER_RESULT naming a fresh file
#               outside both, and writes to that file `done` when done, otherwise the number passing.
#               No file, or anything else in it, is no count. Its exit code and output are only logged.
#               Code sharing the check's process or environment can write that file or exit for it: run
#               the worker's code in a child with ARBITER_RESULT unset and compute the result from its output.
#   FINAL_CMD   optional. Run once in CHECK_DIR when the loop stops for any reason (the held-out set).
#   PROMPT      the prompt file (default <loop-dir>/PROMPT.md, which draws a warning). Each launch freezes
#               a copy in STATE_DIR and every pass reads that copy; a prompt changed since the last launch
#               draws a warning.
#   CHECK_DIR   the working directory for CHECK_CMD and FINAL_CMD (default: a fresh empty one each run).
#   STALL       passes without a new best before stopping (default 3).
#   STATE_DIR   loop.log, logs/, the pass count, the frozen prompt, and STOP. Default:
#               ${XDG_STATE_HOME:-~/.local/state}/arbiter-loop/<loop-dir name>-<checksum of its path>.
#               Refused inside <loop-dir> or containing it.
# Exit codes: 0 done, 1 refused, 2 max passes, 3 stall, 4 STOP file in STATE_DIR, 5 no count before any pass.
# The check runs once before pass 1: if it already passes, no worker runs.
# Ratchet: when <loop-dir> is in a git work tree, each pass's files there (tracked and untracked, .gitignore
# respected) are snapshotted under refs/arbiter/pass-N, the count in its commit message; the index, HEAD and
# branches are never touched. Nothing is restored between passes. At a stall or max-passes exit, if an earlier
# pass beat the final count, the final state is saved as refs/arbiter/final and the files are restored to the
# best pass. A pass during which the pass count was forged is flagged, and a flagged best pass draws a warning.
# Not provided: a timeout or budget, or protection from a worker that kills this script or creates STOP.
set -euo pipefail

dir=${1:?usage: arbiter-loop <loop-dir> [max-passes]}
cap=${2:-20}
stall=${STALL:-3}
: "${AGENT_CMD:?set AGENT_CMD}" "${CHECK_CMD:?set CHECK_CMD}"
case "$cap$stall" in *[!0-9]*) echo "max-passes and STALL must be whole numbers" >&2; exit 1 ;; esac

refuse() { echo "arbiter-loop: refused: $1" >&2; exit 1; }
warn() { echo "arbiter-loop: warning: $1" >&2; }
within() { case "$1/" in "$2"/*) return 0 ;; esac; return 1; } # within <path> <dir>: path is dir or under it

dir=$(cd "$dir" && pwd -P)
prompt=${PROMPT:-$dir/PROMPT.md}
[ -f "$prompt" ] || refuse "no prompt file at $prompt"
prompt=$(cd "$(dirname "$prompt")" && pwd -P)/$(basename "$prompt")
if within "$prompt" "$dir"; then warn "prompt $prompt is inside the loop directory, where the worker can rewrite it for later launches; set PROMPT to a file outside it"; fi
if [ -n "${CHECK_DIR:-}" ]; then
  CHECK_DIR=$(cd "$CHECK_DIR" && pwd -P)
  if within "$CHECK_DIR" "$dir"; then warn "CHECK_DIR is inside the loop directory: the check runs among the worker's files"; fi
fi
if [ -z "${STATE_DIR:-}" ]; then
  [ -e "$dir.arbiter-loop" ] && refuse "$dir.arbiter-loop holds state from an older arbiter-loop, within the worker's reach; move it elsewhere and set STATE_DIR to it to continue that count, or delete it"
  STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/arbiter-loop/$(basename "$dir")-$(printf %s "$dir" | cksum | cut -d' ' -f1)
fi
mkdir -p "$STATE_DIR/logs"
state=$(cd "$STATE_DIR" && pwd -P)
within "$state" "$dir" && refuse "STATE_DIR $state is inside the loop directory"
within "$dir" "$state" && refuse "the loop directory is inside STATE_DIR $state"
log=$state/loop.log
cd "$dir"
echo "arbiter-loop: logs in $state; touch $state/STOP to stop after the current pass" >&2

tamper() { # prints why the pass count on disk was forged, if it was; at launch, and after each pass
  local n=0 last
  [ -f "$state/passes" ] && n=$(cat "$state/passes")
  case "$n" in ''|*[!0-9]*) echo "unreadable pass count in $state/passes"; return 0 ;; esac
  last=$(ls "$state/logs" | sed -n 's/^pass-\([0-9]*\)\.log$/\1/p' | sort -n | tail -n 1)
  if [ "${last:-0}" -gt "$n" ]; then echo "pass count $n in $state/passes is below the log of pass $last; it was changed outside arbiter-loop"; fi
}
# Passes already spent by earlier launches against this state directory.
why=$(tamper); [ -z "$why" ] || refuse "$why"
used=0
[ -f "$state/passes" ] && used=$(cat "$state/passes")

# The ratchet's git commands: no hooks, fsmonitor or signing; never the real index, HEAD or branches.
g() { git -c core.hooksPath=/dev/null -c core.fsmonitor=false -c commit.gpgSign=false "$@"; }
repo=; [ "$(g rev-parse --is-inside-work-tree 2>/dev/null)" = true ] && repo=1
snaptree() { # prints the tree of <loop-dir>'s files now, built in a scratch copy of the index
  local t rc=0; t=$(mktemp -d)
  cp "$(g rev-parse --git-path index)" "$t/index" 2>/dev/null || true
  GIT_INDEX_FILE=$t/index g add -A -- . > /dev/null 2>&1 && GIT_INDEX_FILE=$t/index g write-tree || rc=1
  rm -rf "$t"; return "$rc"
}
snapref() { # snapref <tree> <ref> <message>
  local p= c
  g rev-parse -q --verify 'HEAD^{commit}' > /dev/null && p="-p HEAD"
  c=$(echo "$3" | GIT_AUTHOR_NAME=arbiter-loop GIT_AUTHOR_EMAIL=arbiter-loop@localhost \
    GIT_COMMITTER_NAME=arbiter-loop GIT_COMMITTER_EMAIL=arbiter-loop@localhost g commit-tree "$1" $p) && g update-ref "$2" "$c"
}
restore() { # restore <ref>: <loop-dir>'s files to that snapshot; files saved in refs/arbiter/final but not in it are removed
  local t rc=0; t=$(mktemp -d)
  GIT_INDEX_FILE=$t/index g read-tree refs/arbiter/final && GIT_INDEX_FILE=$t/index g restore -q --source="$1" --worktree -- . || rc=1
  rm -rf "$t"; return "$rc"
}
bestpass= bestcount=-1 bestflag= lastcount=
say() { echo "$1" | tee -a "$log"; }
ratchet() { # at a stall or max-passes exit: report the best pass, and restore it if it beat the final state
  [ -n "$bestpass" ] || return 0
  if [ -z "$repo" ]; then
    say "ratchet: best count $bestcount (pass $bestpass); not a git repository, so nothing was restored"
  elif [ "$bestcount" -le "$lastcount" ]; then
    say "ratchet: best count $bestcount (pass $bestpass, refs/arbiter/pass-$bestpass) is the final state's; nothing was restored"
  elif ! tree=$(snaptree) || ! snapref "$tree" refs/arbiter/final "arbiter-loop final: $lastcount passing"; then
    say "ratchet: best count $bestcount (pass $bestpass, refs/arbiter/pass-$bestpass); the final state could not be saved, so nothing was restored"
  elif restore "refs/arbiter/pass-$bestpass"; then
    say "ratchet: best count $bestcount (pass $bestpass) beat the final $lastcount: final state saved as refs/arbiter/final, files restored to refs/arbiter/pass-$bestpass"
  else
    say "ratchet: best count $bestcount (pass $bestpass): final state saved as refs/arbiter/final, but restoring refs/arbiter/pass-$bestpass failed"
  fi
  if [ -n "$bestflag" ]; then say "ratchet: warning: best pass $bestpass was flagged by the tamper check: $bestflag"; fi
}

if [ -f "$state/prompt.md" ] && ! cmp -s "$prompt" "$state/prompt.md"; then
  warn "prompt $prompt changed since the last launch"; echo "prompt changed since the last launch" >> "$log"
fi
cp "$prompt" "$state/prompt.md"

# Output goes through a pipe, so no file descriptor of the worker or the check points into STATE_DIR.
hide="env -u AGENT_CMD -u CHECK_CMD -u FINAL_CMD -u CHECK_DIR -u PROMPT -u STATE_DIR -u ARBITER_RESULT"
result=
side() { # side <command> <log>: run a check-side command in CHECK_DIR, or a fresh empty directory
  local cwd=${CHECK_DIR:-$(mktemp -d)} rc=0
  (cd "$cwd" && $hide LOOP_DIR="$dir" ARBITER_RESULT="$result" bash -c "$1" 2>&1) | cat > "$2" || rc=$?
  [ -n "${CHECK_DIR:-}" ] || rm -rf "$cwd"
  return "$rc"
}
check() { # check <log>: sets res to "done", the count passing, or "" for no count; rc to the exit code
  local rd; rd=$(mktemp -d); result=$rd/result; rc=0
  side "$CHECK_CMD" "$1" || rc=$?
  res=$(head -n 1 "$result" 2>/dev/null | tr -d '[:space:]' || true); rm -rf "$rd"; result=
  [ "$res" = done ] || case "$res" in ''|*[!0-9]*) res= ;; esac
}
stop() { # stop <exit-code> <message>
  echo "$2" | tee -a "$log"
  case "$1" in 2|3) ratchet ;; esac # before the held-out set, so it grades what is left on disk
  if [ -n "${FINAL_CMD:-}" ]; then
    # One final log per launch, never overwritten: an earlier launch's held-out result stays on disk.
    final=$state/logs/final-pass-$used.log; k=1
    while [ -e "$final" ]; do k=$((k + 1)); final=$state/logs/final-pass-$used-$k.log; done
    if side "$FINAL_CMD" "$final"; then echo "final check: exit 0 ($final)" | tee -a "$log"
    else echo "final check: exit $? (see $final)" | tee -a "$log"; fi
  fi
  exit "$1"
}

echo "start $(date -u +%FT%TZ) dir $dir prompt $prompt cap $cap stall $stall passes used $used" >> "$log"
if [ "$used" -ge "$cap" ]; then
  echo "max passes ($cap) already used by earlier launches; raise max-passes to run more" | tee -a "$log"
  exit 2
fi
check "$state/logs/baseline-$used.log"
[ "$res" = done ] && stop 0 "baseline: check already passes, no agent run"
[ -n "$res" ] || stop 5 "baseline: check wrote no count to ARBITER_RESULT (exit $rc, see $state/logs/baseline-$used.log); fix the check first"
best=$res
flat=0
echo "baseline: $res passing (check exit $rc)" >> "$log"

for ((i = used + 1; i <= cap; i++)); do
  [ -f "$state/STOP" ] && stop 4 "STOP file found before pass $i"
  echo "pass $i start $(date -u +%FT%TZ)" >> "$log"
  used=$i; echo "$used" > "$state/passes" # counted when it starts: a pass killed midway was still spent
  # An agent that dies or exits nonzero is restarted by the next pass, not fatal.
  cat "$state/prompt.md" | $hide bash -c "$AGENT_CMD" 2>&1 | cat > "$state/logs/pass-$i.log" || echo "pass $i: agent exited $?" >> "$log"
  flag=$(tamper); [ -z "$flag" ] || echo "pass $i: flagged by the tamper check: $flag" >> "$log"
  tree=; if [ -n "$repo" ] && ! tree=$(snaptree); then tree=; echo "pass $i: snapshot failed" >> "$log"; fi
  check "$state/logs/check-$i.log"
  if [ -n "$tree" ]; then
    snapref "$tree" "refs/arbiter/pass-$i" "arbiter-loop pass $i: ${res:-no count} passing${flag:+ (flagged: $flag)}" \
      || { tree=; echo "pass $i: snapshot failed" >> "$log"; }
  fi
  [ "$res" = done ] && stop 0 "pass $i: check passed, done"
  if [ -z "$res" ]; then
    echo "pass $i: check wrote no count (exit $rc, see $state/logs/check-$i.log), counted as 0" >> "$log"
    res=0
  else
    echo "pass $i: $res passing (check exit $rc)" >> "$log"
  fi
  lastcount=$res
  if { [ -n "$tree" ] || [ -z "$repo" ]; } && [ "$res" -gt "$bestcount" ]; then bestpass=$i bestcount=$res bestflag=$flag; fi
  if [ "$res" -gt "$best" ]; then best=$res; flat=0; else flat=$((flat + 1)); fi
  [ "$flat" -ge "$stall" ] && stop 3 "stalled: $stall passes without a new best ($best)"
done
stop 2 "hit max passes ($cap), best $best"
